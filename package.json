{
  "name": "rclootcouncil-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB --compatibility-date=2024-09-01",
    "deploy": "wrangler pages deploy public --project-name=rclootcouncil-api",
    "db:create": "wrangler d1 create rclootcouncil-db",
    "db:migrate:local": "wrangler d1 migrations apply rclootcouncil-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply rclootcouncil-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.2",
    "wrangler": "^4.129.0"
  }
}
